# Claves de servicios en la nube. Todas son opcionales: sin ninguna, la skill usa lo que no pide clave.
# Copia este archivo a .env y llena solo las que tengas. Nunca compartas tu .env.

# Voz: https://elevenlabs.io
ELEVENLABS_API_KEY=
# Id de la voz de ElevenLabs; vacío, se usa la primera de tu cuenta que hable español
ELEVENLABS_VOICE_ID=

# Imágenes generadas para cada plano, con FLUX schnell (~$0.003 c/u): https://fal.ai
FAL_KEY=

# LLM por API, para que un modelo escriba sin esperar al asistente: https://openrouter.ai
OPENROUTER_API_KEY=

# Fotos libres de mejor calidad: https://www.pexels.com/api
PEXELS_API_KEY=

# LLM por API, alternativa a OpenRouter: https://platform.deepseek.com
DEEPSEEK_API_KEY=
